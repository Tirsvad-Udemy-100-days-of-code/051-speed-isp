# Copy to .env at the project root and fill in real values. .env is gitignored
# - never commit it (the project's .gitignore ignores .env and .env.*, and keeps
# .env.example).

# Gitea personal access token (Settings -> Applications -> Generate New Token),
# scoped to issues and milestones only. framework/scripts/sync-project.sh
# --apply uses it against a Gitea remote. The older names SYNC_TOKEN and
# GITEA_TOKEN still work as fallbacks.
# NOT a deploy key - deploy keys authenticate git-over-SSH only, not the API.
TOKEN_FOR_GITEA_ISSUES=

# Gitea personal access token with write access to the repository: push, pull
# requests and merge. Kept apart from TOKEN_FOR_GITEA_ISSUES so the sync needs
# nothing broader.
TOKEN_FOR_GITEA_REPO=

########################################
# Settings of the program (speed-isp)
########################################

# The program does not read .env. Set these variables in your shell before you
# run it (see the README, "Setup"). They are listed here as comments so that no
# real value is ever put in this file. Never commit a password.
#
# Practice service "Y" (the default service):
# Y_EMAIL=
# Y_PASSWORD=
#
# Service X (set SPEED_ISP_SERVICE=X):
# TWITTER_EMAIL=
# TWITTER_PASSWORD=
# SPEED_ISP_SERVICE=X
#
# The provider to mention in the complaint, for example @Comcast:
# SPEED_ISP_PROVIDER=
#
# Browser settings. SPEED_ISP_HEADLESS=1 runs Chrome without a window;
# CHROME_BIN and CHROMEDRIVER point to the browser and its driver; the
# screenshot folder is where the bot writes its screenshots:
# SPEED_ISP_HEADLESS=1
# CHROME_BIN=
# CHROMEDRIVER=
# SPEED_ISP_SCREENSHOT_DIR=
